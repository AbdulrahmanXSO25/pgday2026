{
  "name": "@pgegypt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:server": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src || true",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "hono": "^4.7.8",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.7.3",
    "zod": "^4.4.3",
    "drizzle-orm": "^0.38.3",
    "@pgegypt/validation": "workspace:*",
    "@pgegypt/types": "workspace:*",
    "@pgegypt/config": "workspace:*",
    "@pgegypt/db": "workspace:*",
    "@pgegypt/auth": "workspace:*",
    "@pgegypt/queue": "workspace:*",
    "@pgegypt/mail": "workspace:*",
    "@pgegypt/storage": "workspace:*",
    "@pgegypt/publish": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "tsx": "^4.19.0",
    "@types/node": "^22.13.0",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^9.2.2",
    "vitest": "^3.0.0"
  }
}
