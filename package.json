{
  "name": "pgegypt-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "PG Day Egypt 2026 — monorepo (public-web, admin-web, api) on pnpm+Turborepo",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:public": "turbo run dev --filter=@pgegypt/public-web",
    "dev:admin": "turbo run dev --filter=@pgegypt/admin-web",
    "dev:api": "turbo run dev --filter=@pgegypt/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "e2e:api": "playwright test --project=api-e2e",
    "e2e:ui": "playwright test --project=ui-e2e",
    "ci:local": "bash scripts/ci-local.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "media:cleanup": "node scripts/media-cleanup.mjs",
    "job:reminders": "node scripts/job-reminders.mjs",
    "db:migrate": "pnpm --filter @pgegypt/db exec pnpm migrate",
    "db:seed": "pnpm --filter @pgegypt/db exec pnpm seed"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.53.0",
    "@vitest/coverage-v8": "^3.0.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.4",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0",
    "wrangler": "^4.124.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
