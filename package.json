{
  "name": "pgegypt-2026",
  "version": "0.1.0",
  "private": true,
  "description": "PG Day Egypt 2026 — official conference site (Next.js App Router, deployed to Cloudflare Workers via OpenNext)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "db:create": "wrangler d1 create pgegypt-db",
    "db:migrations:new": "wrangler d1 migrations create pgegypt-db",
    "db:migrate:local": "wrangler d1 migrations apply pgegypt-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pgegypt-db --remote",
    "db:query:local": "wrangler d1 execute pgegypt-db --local --command",
    "db:query:remote": "wrangler d1 execute pgegypt-db --remote --command",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3",
    "resend": "^6.20.0",
    "lucide-react": "^1.32.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2",
    "@opennextjs/cloudflare": "^1.20.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.1",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.3.0",
    "@eslint/eslintrc": "^3.2.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "wrangler": "^4.123.0",
    "@cloudflare/workers-types": "^5.20260819.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
