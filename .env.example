# PG Day Egypt — local development env (all values are LOCAL-ONLY defaults).
# Copy to .env.local per app/package as needed. Never commit real secrets.
# See specs.md §30.6 & §34.

# --- api (apps/api) ---
RUNTIME=development
PORT=8787
DB_FILE=../../packages/db/data/local.db
PUBLISH_DIR=../../apps/public-web/content

# --- storage (local MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=pgegypt-media
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000

# --- mail (local Maildev) ---
MAILDEV_HOST=localhost
MAILDEV_SMTP_PORT=1025
MAILDEV_HTTP_PORT=1080
EMAIL_FROM="PG Day Egypt <noreply@pgegypt.local>"

# --- admin-web ---
API_BASE_URL=http://localhost:8787

# --- public-web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- production-only (set via `wrangler secret put`, NEVER here) ---
# RESEND_API_KEY=
# GITHUB_DISPATCH_TOKEN=
# CLOUDFLARE_API_TOKEN=
