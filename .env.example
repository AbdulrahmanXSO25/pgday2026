# Local development environment
# Copy this file to .env.local (per app) or export the values in your shell.
# All values here are LOCAL-ONLY defaults. Never commit real secrets.

# --- API (apps/api) ---
RUNTIME=development
PORT=8787
DB_FILE=../../packages/db/data/local.db
PUBLISH_DIR=../../apps/public-web/content

# --- File storage (local MinIO via docker-compose) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=pgegypt-media
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000

# --- Email (local Maildev via docker-compose) ---
MAILDEV_HOST=localhost
MAILDEV_SMTP_PORT=1025
MAILDEV_HTTP_PORT=1080
EMAIL_FROM="PG Day Egypt <noreply@pgegypt.local>"

# --- Admin panel (apps/admin-web) ---
API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Public site (apps/public-web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Production-only (set via `wrangler secret put`, NEVER here) ---
# RESEND_API_KEY=
# GITHUB_DISPATCH_TOKEN=
# CLOUDFLARE_API_TOKEN=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=