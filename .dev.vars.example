# Copy to .dev.vars and fill in real values for local development.
# Never commit .dev.vars to git.

# D1 database (local dev uses the local binding automatically — no vars needed)

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Email "from" address (must be a verified domain on Resend)
EMAIL_FROM="PG Day Egypt <hello@pgegypt.org>"

# Public site URL, used in emails and metadata
SITE_URL="https://pgegypt.org"

# D1 database id for the remote database (from `npm run db:create`)
D1_DATABASE_ID=
